----------------------------------------------------------------------
-- Save / load (folder: SUNDOWN)
----------------------------------------------------------------------
local FOLDER = "SUNDOWN"
local FILE = FOLDER .. "/settings.json"
local SKIP = { Fly = true, Noclip = true, TPTarget = true } -- runtime state, never persisted

local canFS = type(writefile) == "function" and type(readfile) == "function"
    and type(makefolder) == "function" and type(isfolder) == "function" and type(isfile) == "function"

local savedUI
local dirtyAt
local saveSettings -- assigned after the UI table exists

local function ensureFolder()
    if not canFS then return false end
    local ok = pcall(function()
        if not isfolder(FOLDER) then makefolder(FOLDER) end
    end)
    return ok
end

local function loadSettings()
    if not ensureFolder() then return end
    pcall(function()
        if not isfile(FILE) then return end
        local data = HttpService:JSONDecode(readfile(FILE))
        if type(data) ~= "table" then return end
        for k, v in pairs(data) do
            if k ~= "__ui" and not SKIP[k] and Settings[k] ~= nil and type(Settings[k]) == type(v) then
                Settings[k] = v
            end
        end
        if type(data.__ui) == "table" then savedUI = data.__ui end
    end)
end

loadSettings()

local function markDirty()
    dirtyAt = os.clock()
end

----------------------------------------------------------------------
-- Keybind helpers
----------------------------------------------------------------------
local function keyLabel(name)
    return name == "None" and "-" or name
end

local function validKeyName(name)
    if name == "None" then return true end
    local ok = pcall(function() return Enum.KeyCode[name].Value end)
    return ok
end

for _, k in ipairs(BIND_KEYS) do
    if type(Settings[k]) ~= "string" or not validKeyName(Settings[k]) then
        Settings[k] = Defaults[k]
    end
end

local function pressed(input, bindKey)
    local b = Settings[bindKey]
    return b ~= "None" and input.KeyCode.Name == b
end

local function keyDown(bindKey)
    local n = Settings[bindKey]
    if n == "None" then return false end
    local ok, kc = pcall(function() return Enum.KeyCode[n] end)
    return ok and kc ~= nil and UserInputService:IsKeyDown(kc)
end

----------------------------------------------------------------------
-- Text helpers (crisp text)
----------------------------------------------------------------------
local FONT_IDS = { UI = 0, System = 1, Plex = 2, Monospace = 3 }
local FONT_NAMES = { "UI", "System", "Plex", "Monospace" }

local function fontId()
    local name = Settings.Font
    if Drawing.Fonts and Drawing.Fonts[name] ~= nil then return Drawing.Fonts[name] end
    return FONT_IDS[name] or 0
end

local BLACK = Color3.new(0, 0, 0)

local function styleText(d)
    pcall(function() d.Font = fontId() end)
    pcall(function() d.Outline = true end)
    pcall(function() d.OutlineColor = BLACK end)
end

-- Snap to whole pixels: fractional text coordinates make Drawing text look blurry
local function P(x, y)
    return Vector2.new(math.floor(x + 0.5), math.floor(y + 0.5))
end

local function tw(d)
    local ok, b = pcall(function() return d.TextBounds.X end)
    if ok and b and b > 0 then return b end
    return #d.Text * d.Size * 0.55
end

----------------------------------------------------------------------
-- Synthwave sunset palette
----------------------------------------------------------------------
local STOPS = {
    { 0.00, Color3.fromRGB(255, 238, 110) },
    { 0.16, Color3.fromRGB(255, 184, 60) },
    { 0.32, Color3.fromRGB(255, 112, 80) },
    { 0.48, Color3.fromRGB(255, 52, 140) },
    { 0.64, Color3.fromRGB(214, 58, 214) },
    { 0.80, Color3.fromRGB(136, 74, 255) },
    { 1.00, Color3.fromRGB(56, 128, 255) },
}

local STEPS = 160
local GRAD = table.create(STEPS)
for i = 1, STEPS do
    local t = (i - 1) / (STEPS - 1)
    for s = 1, #STOPS - 1 do
        local a, b = STOPS[s], STOPS[s + 1]
        if t <= b[1] or s == #STOPS - 1 then
            local u = math.clamp((t - a[1]) / (b[1] - a[1]), 0, 1)
            u = u * u * (3 - 2 * u)
            GRAD[i] = a[2]:Lerp(b[2], u)
            break
        end
    end
end

local function grad(t)
    return GRAD[math.floor(math.clamp(t, 0, 1) * (STEPS - 1) + 0.5) + 1]
end

local function gradAnim(t, offset)
    local p = (t + offset) % 2
    if p > 1 then p = 2 - p end
    return grad(p)
end

local C0, C1 = grad(0), grad(1)

----------------------------------------------------------------------
-- ESP drawing pool
----------------------------------------------------------------------
local FILL_N, HP_N, TRACER_N = 10, 4, 8

local function newDrawing(class, props, pool)
    local d = Drawing.new(class)
    if class == "Text" then styleText(d) end
    for k, v in pairs(props) do
        d[k] = v
    end
    d.Visible = false
    pool[#pool + 1] = d
    return d
end

local function newSet()
    local all = {}
    local s = { All = all, Fill = {}, Box = {}, HP = {}, Tracer = {}, Shown = false }

    for i = 1, FILL_N do
        s.Fill[i] = newDrawing("Square", { Filled = true, Thickness = 1 }, all)
    end
    for i = 1, 10 do
        s.Box[i] = newDrawing("Line", { Thickness = 2 }, all)
    end
    s.Name = newDrawing("Text", { Center = true }, all)
    s.Dist = newDrawing("Text", { Center = true }, all)
    s.Tool = newDrawing("Text", { Center = true }, all)
    s.HPBG = newDrawing("Line", { Thickness = 5, Color = BLACK, Transparency = 0.6 }, all)
    for i = 1, HP_N do
        s.HP[i] = newDrawing("Line", { Thickness = 3 }, all)
    end
    s.HPText = newDrawing("Text", {}, all)
    for i = 1, TRACER_N do
        s.Tracer[i] = newDrawing("Line", { Thickness = 1 }, all)
    end
    s.Head = newDrawing("Circle", { Filled = false, Thickness = 1, NumSides = 18 }, all)
    return s
end

local function hideSet(s)
    if not s.Shown then return end
    s.Shown = false
    for _, d in ipairs(s.All) do
        d.Visible = false
    end
end

local function freeSet(s)
    for _, d in ipairs(s.All) do
        d:Remove()
    end
end

local Sets = {}
local Tracked = {}
local NPCModels = {}

local function acquire(key)
    local s = newSet()
    Sets[key] = s
    return s
end

local function release(key)
    local s = Sets[key]
    if s then
        freeSet(s)
        Sets[key] = nil
    end
end

