local function inRect(m, x, y, w, h)
    return m.X >= x and m.X <= x + w and m.Y >= y and m.Y <= y + h
end

local function visRows()
    return math.max(1, math.floor((UI.H - BODY_TOP - FOOT) / ROWH))
end

local function maxScroll(tab)
    return math.max(0, #TABS[tab].items - visRows())
end

local function rowVisible(w)
    local r = w.row - UI.Scroll[w.tab]
    return r >= 1 and r <= visRows()
end

local function rowRect(w)
    local r = w.row - UI.Scroll[w.tab]
    return UI.X + 6, UI.Y + BODY_TOP + (r - 1) * ROWH, UI.W - 16
end

local function sliderGeom(rx, rw)
    local ts = Settings.MenuTextSize
    local labW = math.floor(ts * 10)
    local valW = math.floor(ts * 4)
    return rx + labW, math.max(rw - labW - valW, 20)
end

local function applySlider(w, mx)
    local it = w.item
    local rx, _, rw = rowRect(w)
    local trackX, trackW = sliderGeom(rx, rw)
    local t = math.clamp((mx - trackX) / trackW, 0, 1)
    local v = it.min + t * (it.max - it.min)
    v = math.floor(v / it.step + 0.5) * it.step
    v = math.clamp(v, it.min, it.max)
    if Settings[it.key] ~= v then
        Settings[it.key] = v
        if it.onChange then it.onChange(v) end
    end
end

local appliedFont

