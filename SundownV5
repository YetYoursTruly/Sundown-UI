----------------------------------------------------------------------
-- Field of view: smooth camera FOV (works in any game) or ByteNet remote
----------------------------------------------------------------------
local FOVRemote
local lastFOV

local function sendFOV(value, force)
    value = math.clamp(math.round(value), 70, 120)
    if not FOVRemote then return end
    if not force and value == lastFOV then return end
    lastFOV = value

    local data = buffer.create(5)
    buffer.writeu8(data, 0, 8)
    buffer.writeu8(data, 1, value)
    buffer.writeu8(data, 2, 0)
    buffer.writeu8(data, 3, 0)
    buffer.writeu8(data, 4, 0)
    FOVRemote:FireServer(data, nil)
end

-- Only looked up; the packet is only ever sent when FOV Method is set to ByteNet
task.spawn(function()
    FOVRemote = ReplicatedStorage:WaitForChild("ByteNetReliable", 10)
end)

local fovState = { active = false, orig = 70 }

local function fovStep(dt)
    if Settings.FOVMethod == "ByteNet" then
        if fovState.active then
            Camera.FieldOfView = fovState.orig
            fovState.active = false
        end
        if Settings.FOVEnabled then
            sendFOV(Settings.CameraFOV)
        elseif lastFOV and lastFOV ~= 70 then
            sendFOV(70)
        end
        return
    end

    -- leftover from ByteNet mode
    if lastFOV and lastFOV ~= 70 then sendFOV(70) end

    local target
    if Settings.FOVEnabled then
        if not fovState.active then
            fovState.active = true
            fovState.orig = Camera.FieldOfView
        end
        target = Settings.CameraFOV
    elseif fovState.active then
        target = fovState.orig
    else
        return
    end

    -- exponential ease: smooth tween toward the target, and it re-asserts against games that reset FOV
    local cur = Camera.FieldOfView
    local nxt = cur + (target - cur) * (1 - math.exp(-dt * 10))
    if math.abs(target - nxt) < 0.05 then
        nxt = target
        if not Settings.FOVEnabled then fovState.active = false end
    end
    Camera.FieldOfView = nxt
end

----------------------------------------------------------------------
-- Fullbright: default ambient, no fog, sky hidden (nothing is ever deleted)
----------------------------------------------------------------------
local DEFAULT_AMBIENT = Color3.fromRGB(70, 70, 70) -- Roblox default Ambient / OutdoorAmbient
local NO_FOG_END = 1e7

local FB = { active = false, ambient = nil, outdoor = nil, clockTime = nil, fogStart = nil, fogEnd = nil, fogApplied = false, shadows = nil, hidden = {} }

local function fbRestoreFog()
    if FB.fogApplied then
        Lighting.FogStart = FB.fogStart
        Lighting.FogEnd = FB.fogEnd
        FB.fogApplied = false
    end
end

local function fbReconcileObjects()
    -- hide matching objects by un-parenting them (kept in memory so they can be put back)
    for _, o in ipairs(Lighting:GetChildren()) do
        if (Settings.FBSky and o:IsA("Sky")) or (Settings.FBFog and o:IsA("Atmosphere")) then
            FB.hidden[o] = o.Parent
            o.Parent = nil
        end
    end
    -- put back anything that is no longer wanted hidden
    for o, parent in pairs(FB.hidden) do
        local want = (o:IsA("Sky") and Settings.FBSky) or (o:IsA("Atmosphere") and Settings.FBFog)
        if not want then
            pcall(function() o.Parent = parent end)
            FB.hidden[o] = nil
        end
    end
end

local function fullbrightStep()
    if Settings.Fullbright then
		Lighting.ClockTime = 12
        if not FB.active then
            FB.active = true
			FB.clockTime = Lighting.ClockTime
            FB.ambient, FB.outdoor = Lighting.Ambient, Lighting.OutdoorAmbient
            FB.shadows = Lighting.GlobalShadows
        end
        Lighting.GlobalShadows = false

        local c = Settings.FBMode == "Bright" and Color3.new(1, 1, 1) or DEFAULT_AMBIENT
        if Lighting.Ambient ~= c then Lighting.Ambient = c end
        if Lighting.GlobalShadows ~= false then Lighting.GlobalShadows = false end
        if Lighting.OutdoorAmbient ~= c then Lighting.OutdoorAmbient = c end

        if Settings.FBFog then
            if not FB.fogApplied then
                FB.fogStart, FB.fogEnd = Lighting.FogStart, Lighting.FogEnd
                FB.fogApplied = true
            end
            if Lighting.FogEnd ~= NO_FOG_END then Lighting.FogEnd = NO_FOG_END end
        else
            fbRestoreFog()
        end

        fbReconcileObjects()
    elseif FB.active then
        FB.active = false
		
		if FB.clockTime ~= nil then
    		Lighting.ClockTime = FB.clockTime
		end

        if FB.ambient then Lighting.Ambient = FB.ambient end
        if FB.outdoor then Lighting.OutdoorAmbient = FB.outdoor end
        if FB.shadows ~= nil then Lighting.GlobalShadows = FB.shadows end
        fbRestoreFog()
        for o, parent in pairs(FB.hidden) do
            pcall(function() o.Parent = parent end)
            FB.hidden[o] = nil
        end
    end
end

----------------------------------------------------------------------
-- Movement: fly, noclip, teleport
----------------------------------------------------------------------
local function getChar()
    local c = LocalPlayer.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    local root = hum and (hum.RootPart or c:FindFirstChild("HumanoidRootPart"))
    return c, hum, root
end

local function teleportCFrame(cf)
    local _, _, root = getChar()
    if not root then return end
    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = cf
end

local function playerNames()
    local names = {}
    for p in pairs(Tracked) do
        names[#names + 1] = p.Name
    end
    table.sort(names)
    if #names == 0 then names[1] = "None" end
    return names
end

local function teleportToTarget()
    local p = Players:FindFirstChild(Settings.TPTarget)
    if not p or not p:IsA("Player") then return end
    local tc = p.Character
    local troot = tc and tc:FindFirstChild("HumanoidRootPart")
    if troot then
        teleportCFrame(CFrame.new(troot.Position + Vector3.new(0, 3, 0)))
    end
end

local function teleportToNearest()
    local _, _, root = getChar()
    if not root then return end
    local best, bestD
    for p in pairs(Tracked) do
        local c = p.Character
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and r then
            local d = (r.Position - root.Position).Magnitude
            if not bestD or d < bestD then
                best, bestD = r, d
            end
        end
    end
    if best then
        teleportCFrame(CFrame.new(best.Position + Vector3.new(0, 3, 0)))
    end
end

local clickParams = RaycastParams.new()
clickParams.FilterType = Enum.RaycastFilterType.Exclude

local function clickTeleport()
    local c = LocalPlayer.Character
    clickParams.FilterDescendantsInstances = { c, Camera }
    local m = UserInputService:GetMouseLocation()
    local ray = Camera:ViewportPointToRay(m.X, m.Y)
    local hit = workspace:Raycast(ray.Origin, ray.Direction * 5000, clickParams)
    if hit then
        teleportCFrame(CFrame.new(hit.Position + Vector3.new(0, 3.5, 0)))
    end
end

local flyActive = false
local noclipParts = {}

local function restoreNoclip()
    for part in pairs(noclipParts) do
        if part.Parent then part.CanCollide = true end
    end
    table.clear(noclipParts)
end

Conns[#Conns + 1] = RunService.Heartbeat:Connect(function()
    local _, hum, root = getChar()

    if Settings.Fly and hum and root and hum.Health > 0 then
        flyActive = true
        if not hum.PlatformStand then hum.PlatformStand = true end

        local dir = Vector3.zero
        if not UserInputService:GetFocusedTextBox() then
            local cf = Camera.CFrame
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
            if keyDown("BindFlyUp") then dir += Vector3.yAxis end
            if keyDown("BindFlyDown") then dir -= Vector3.yAxis end
        end

        local speed = Settings.FlySpeed
        if keyDown("BindFlyBoost") then speed = speed * 2 end

        root.AssemblyLinearVelocity = dir.Magnitude > 0 and dir.Unit * speed or Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero

        local look = Camera.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude > 0.01 then
            root.CFrame = CFrame.new(root.Position, root.Position + flat)
        end
    elseif flyActive then
        flyActive = false
        if hum then hum.PlatformStand = false end
        if root then root.AssemblyLinearVelocity = Vector3.zero end
    end
end)

Conns[#Conns + 1] = RunService.Stepped:Connect(function()
    if Settings.Noclip then
        local c = LocalPlayer.Character
        if c then
            for _, part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    noclipParts[part] = true
                    part.CanCollide = false
                end
            end
        end
    elseif next(noclipParts) then
        restoreNoclip()
    end
end)

----------------------------------------------------------------------
-- Drawing the ESP for one entity
----------------------------------------------------------------------
local TracerOrigin = Vector2.new(0, 0)

local function locate(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local root = hum.RootPart or char.PrimaryPart or char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local dist = (Camera.CFrame.Position - root.Position).Magnitude
    if dist > Settings.MaxDistance then return end

    local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
    if not onScreen then return end
    return hum, root, dist, pos
end

local function setLine(l, ax, ay, bx, by, color)
    l.From = Vector2.new(ax, ay)
    l.To = Vector2.new(bx, by)
    l.Color = color
    l.Visible = true
end

local function draw(s, char, hum, root, dist, pos, name)
    s.Shown = true

    local rp = root.Position
    local top = Camera:WorldToViewportPoint(rp + Vector3.new(0, 2.8, 0))
    local bot = Camera:WorldToViewportPoint(rp - Vector3.new(0, 3.2, 0))
    local h = math.abs(bot.Y - top.Y)
    local w = h * 0.6
    local x, y = pos.X - w / 2, top.Y
    local r, b = x + w, y + h

    local fill = Settings.BoxFill
    local sh = h / FILL_N
    for i = 1, FILL_N do
        local sq = s.Fill[i]
        sq.Visible = fill
        if fill then
            sq.Position = Vector2.new(x, y + sh * (i - 1))
            sq.Size = Vector2.new(w, sh + 1)
            sq.Color = grad((i - 0.5) / FILL_N)
            sq.Transparency = Settings.FillOpacity
        end
    end

    local used = 0
    if Settings.Box then
        local B = s.Box
        if Settings.BoxStyle == "Full" then
            setLine(B[1], x, y, r, y, C0)
            setLine(B[2], x, b, r, b, C1)
            for i = 1, 4 do
                local y1, y2 = y + h * (i - 1) / 4, y + h * i / 4
                local c = grad((i - 0.5) / 4)
                setLine(B[2 + i], x, y1, x, y2, c)
                setLine(B[6 + i], r, y1, r, y2, c)
            end
            used = 10
        else
            local lx, ly = w * 0.3, h * 0.2
            local ct, cb = grad(0.1), grad(0.9)
            setLine(B[1], x, y, x + lx, y, C0)
            setLine(B[2], x, y, x, y + ly, ct)
            setLine(B[3], r, y, r - lx, y, C0)
            setLine(B[4], r, y, r, y + ly, ct)
            setLine(B[5], x, b, x + lx, b, C1)
            setLine(B[6], x, b, x, b - ly, cb)
            setLine(B[7], r, b, r - lx, b, C1)
            setLine(B[8], r, b, r, b - ly, cb)
            used = 8
        end
    end
    for i = used + 1, 10 do
        s.Box[i].Visible = false
    end

    local ts = math.floor(Settings.TextSize + 0.5)

    local nameT = s.Name
    nameT.Visible = Settings.Name
    if Settings.Name then
        nameT.Text = name
        nameT.Size = ts
        nameT.Color = Color3.fromRGB(255, 245, 225)
        nameT.Position = P(pos.X, y - ts - 5)
    end

    local belowY = b + 3
    local distT = s.Dist
    distT.Visible = Settings.Distance
    if Settings.Distance then
        distT.Text = string.format("[%dm]", math.floor(dist))
        distT.Size = ts
        distT.Color = grad(0.12)
        distT.Position = P(pos.X, belowY)
        belowY = belowY + ts + 2
    end

    local tool = Settings.Tool and char:FindFirstChildOfClass("Tool")
    local toolT = s.Tool
    toolT.Visible = tool and true or false
    if tool then
        toolT.Text = tool.Name
        toolT.Size = ts
        toolT.Color = grad(0.5)
        toolT.Position = P(pos.X, belowY)
    end

    local showHP = Settings.Health
    local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
    local hx = x - 6
    s.HPBG.Visible = showHP
    if showHP then
        s.HPBG.From = Vector2.new(hx, b + 1)
        s.HPBG.To = Vector2.new(hx, y - 1)
    end
    local segH = h / HP_N
    for i = 1, HP_N do
        local seg = s.HP[i]
        local part = showHP and math.clamp(pct * HP_N - (i - 1), 0, 1) or 0
        if part > 0 then
            local yb = b - segH * (i - 1)
            seg.From = Vector2.new(hx, yb)
            seg.To = Vector2.new(hx, yb - segH * part)
            seg.Color = grad(1 - (i - 0.5) / HP_N)
            seg.Visible = true
        else
            seg.Visible = false
        end
    end

    local hpT = s.HPText
    hpT.Visible = showHP and Settings.HealthText
    if hpT.Visible then
        hpT.Text = tostring(math.floor(hum.Health))
        hpT.Size = math.max(ts - 2, 10)
        hpT.Color = Color3.fromRGB(255, 245, 225)
        hpT.Position = P(hx - 6 - tw(hpT), b - h * pct - 6)
    end

    if Settings.Tracers then
        local target = Vector2.new(pos.X, b)
        for i = 1, TRACER_N do
            local l = s.Tracer[i]
            l.From = TracerOrigin:Lerp(target, (i - 1) / TRACER_N)
            l.To = TracerOrigin:Lerp(target, i / TRACER_N)
            l.Color = grad(0.95 - 0.9 * (i - 0.5) / TRACER_N)
            l.Visible = true
        end
    else
        for i = 1, TRACER_N do
            s.Tracer[i].Visible = false
        end
    end

    local head = Settings.HeadDot and char:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        local hp = Camera:WorldToViewportPoint(head.Position)
        s.Head.Position = Vector2.new(hp.X, hp.Y)
        s.Head.Radius = math.max(h * 0.06, 2)
        s.Head.Color = grad(0.3)
        s.Head.Visible = true
    else
        s.Head.Visible = false
    end
end

