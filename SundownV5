end

local function footerText()
    return string.format("%s menu   %s unload   %s fly",
        keyLabel(Settings.BindMenu), keyLabel(Settings.BindUnload), keyLabel(Settings.BindFly))
end

local function getZoomDistance()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root and Camera then
        return (Camera.CFrame.Position - root.Position).Magnitude
    end
    return nil
end

local function renderUI(dt)
    if not UI.Open then
        if UI.Shown then
            for _, d in ipairs(UIAll) do d.Visible = false end
            for _, w in ipairs(Widgets) do w.Shown = false end
            UI.Shown = false
        end
        UI.Drag, UI.Resize, UI.Slider, UI.Listening = nil, nil, nil, nil
        return
    end
    UI.Shown = true

    if appliedFont ~= Settings.Font then applyFontEverywhere() end

    local m = UserInputService:GetMouseLocation()
    local vp = Camera.ViewportSize
    local clock = os.clock()
    local ts = math.floor(Settings.MenuTextSize + 0.5)

    if UI.Resize then
        UI.W = math.floor(math.clamp(UI.Resize.W + (m.X - UI.Resize.MX), MIN_W, math.min(MAX_W, math.max(vp.X - UI.X, MIN_W))))
        UI.H = math.floor(math.clamp(UI.Resize.H + (m.Y - UI.Resize.MY), MIN_H, math.min(MAX_H, math.max(vp.Y - UI.Y, MIN_H))))
    elseif UI.Drag then
        UI.X = math.floor(math.clamp(m.X - UI.Drag.X, 0, math.max(vp.X - UI.W, 0)))
        UI.Y = math.floor(math.clamp(m.Y - UI.Drag.Y, 0, math.max(vp.Y - UI.H, 0)))
    end
    if UI.Slider then
        applySlider(UI.Slider, m.X)
    end

    -- smooth scroll: ease Scroll toward ScrollT every frame
    for i = 1, #TABS do
        UI.ScrollT[i] = math.clamp(UI.ScrollT[i], 0, maxScroll(i))
        local target = UI.ScrollT[i]
        local nextS = UI.Scroll[i] + (target - UI.Scroll[i]) * (1 - math.exp(-(dt or 0.016) * 14))
        if math.abs(target - nextS) < 0.005 then nextS = target end
        UI.Scroll[i] = nextS
    end

    local X, Y, W, H = UI.X, UI.Y, UI.W, UI.H

-- lock camera zoom while the mouse is over the menu (prevents Roblox zoom-out on wheel)
    local mouseOverMenu = inRect(m, X, Y, W, H)
    if mouseOverMenu and not UI.ZoomLock then
        if not UI.HaveZoom then
            local zd = getZoomDistance()
            if zd then
                UI.LockedZoom = zd
                UI.HaveZoom = true
            end
        end
        if UI.HaveZoom then
            UI.ZoomLock = true
            UI.OrigMinZoom = LocalPlayer.CameraMinZoomDistance
            UI.OrigMaxZoom = LocalPlayer.CameraMaxZoomDistance
            LocalPlayer.CameraMinZoomDistance = UI.LockedZoom
            LocalPlayer.CameraMaxZoomDistance = UI.LockedZoom
        end
    elseif not mouseOverMenu and UI.ZoomLock then
        UI.ZoomLock = false
        pcall(function()
            LocalPlayer.CameraMinZoomDistance = UI.OrigMinZoom
            LocalPlayer.CameraMaxZoomDistance = UI.OrigMaxZoom
        end)
    end

    uiBorder.Position, uiBorder.Size, uiBorder.Visible = Vector2.new(X, Y), Vector2.new(W, H), true
    uiBorder.Color = gradAnim(0.5, clock * 0.08)

    local bodyH = H - HEADER
    local bh = bodyH / BG_N
    for i, st in ipairs(bgStrips) do
        st.Position = Vector2.new(X, Y + HEADER + bh * (i - 1))
        st.Size = Vector2.new(W, bh + 1)
        st.Visible = true
    end

    local sw = W / HEAD_N
    local drift = clock * 0.06
    for i = 1, HEAD_N do
        local t = (i - 1) / (HEAD_N - 1)
        local hs, gs = headStrips[i], glowStrips[i]
        hs.Position = Vector2.new(X + sw * (i - 1), Y)
        hs.Size = Vector2.new(sw + 1, HEADER)
        hs.Color = gradAnim(t * 0.9, drift)
        hs.Visible = true
        gs.Position = Vector2.new(X + sw * (i - 1), Y + HEADER)
        gs.Size = Vector2.new(sw + 1, 3)
        gs.Color = gradAnim(t * 0.9, drift)
        gs.Visible = true
    end

    uiTitle.Size = ts + 3
    uiTitle.Position = P(X + W / 2, Y + (HEADER - (ts + 3)) / 2 - 1)
    uiTitle.Visible = true

    if UI.Listening then
        uiFoot.Text = "Press a key  (Esc = cancel, Backspace = clear)"
    elseif clock < flashUntil then
        uiFoot.Text = flashMsg
    else
        uiFoot.Text = footerText()
    end
    uiFoot.Size = math.max(ts - 3, 10)
    uiFoot.Position = P(X + W / 2, Y + H - FOOT + 4)
    uiFoot.Color = gradAnim(0.6, drift)
    uiFoot.Visible = true

    for i, l in ipairs(gripLines) do
        local o = i * 4
        l.From = Vector2.new(X + W - 2, Y + H - 2 - o)
        l.To = Vector2.new(X + W - 2 - o, Y + H - 2)
        l.Color = grad(0.35 + i * 0.15)
        l.Visible = true
    end

    local tabW = (W - 12) / #TABS
    -- shrink tab labels if they would not fit (longest name is 6 characters)
    local tabSize = math.clamp(math.floor((tabW - 10) / (6 * 0.6)), 9, math.max(ts - 3, 10))
    for i = 1, #TABS do
        local bgd, tx = tabBG[i], tabTxt[i]
        local tx0 = X + 6 + (i - 1) * tabW
        bgd.Position = Vector2.new(tx0, Y + HEADER + 8)
        bgd.Size = Vector2.new(tabW - 4, TABH)
        bgd.Visible = true
        tx.Size = tabSize
        tx.Position = P(tx0 + (tabW - 4) / 2, Y + HEADER + 8 + (TABH - tabSize) / 2 - 1)
        tx.Visible = true
        if i == UI.Tab then
            bgd.Color = gradAnim(0.15 + 0.7 * (i - 1) / #TABS, drift)
        else
            bgd.Color = Color3.fromRGB(44, 20, 78)
        end
    end

    local rows = visRows()
    local total = #TABS[UI.Tab].items
    if total > rows then
        local trackH = rows * ROWH - 2
        local thumbH = math.max(trackH * rows / total, 14)
        local frac = UI.Scroll[UI.Tab] / math.max(total - rows, 1)
        sbTrack.Position = Vector2.new(X + W - 7, Y + BODY_TOP)
        sbTrack.Size = Vector2.new(3, trackH)
        sbTrack.Visible = true
        sbThumb.Position = Vector2.new(X + W - 7, Y + BODY_TOP + (trackH - thumbH) * frac)
        sbThumb.Size = Vector2.new(3, thumbH)
        sbThumb.Color = gradAnim(0.4, drift)
        sbThumb.Visible = true
    else
        sbTrack.Visible = false
        sbThumb.Visible = false
    end

    local textY = (ROWH - ts) / 2 - 1

    for _, w in ipairs(Widgets) do
        local it = w.item
        if w.tab ~= UI.Tab or not rowVisible(w) then
            if w.Shown then
                for _, d in ipairs(w.all) do d.Visible = false end
                w.Shown = false
            end
        else
            w.Shown = true
            local rx, ry, rw = rowRect(w)
            local val = it.key and Settings[it.key]

            w.Hover.Position = Vector2.new(rx, ry)
            w.Hover.Size = Vector2.new(rw, ROWH - 2)
            w.Hover.Visible = inRect(m, rx, ry, rw, ROWH) and not UI.Resize and not UI.Drag

            w.Label.Text = it.label
            w.Label.Size = ts
            w.Label.Visible = true

            if it.type == "toggle" then
                w.Label.Position = P(rx + 30, ry + textY)
                w.Box.Position = Vector2.new(rx + 7, ry + 4)
                w.Box.Size = Vector2.new(16, 16)
                w.Box.Visible = true
                w.Check.Position = Vector2.new(rx + 10, ry + 7)
                w.Check.Size = Vector2.new(10, 10)
                w.Check.Visible = val and true or false
            elseif it.type == "cycle" then
                w.Label.Position = P(rx + 8, ry + textY)
                w.Value.Text = "[" .. tostring(val) .. "]"
                w.Value.Size = ts
                w.Value.Color = grad(0.12)
                w.Value.Position = P(rx + rw - 8 - tw(w.Value), ry + textY)
                w.Value.Visible = true
            elseif it.type == "bind" then
                w.Label.Position = P(rx + 8, ry + textY)
                if UI.Listening == w then
                    w.Value.Text = "[press a key...]"
                    w.Value.Color = gradAnim(0.0, clock * 0.8)
                else
                    w.Value.Text = "[" .. keyLabel(val) .. "]"
                    w.Value.Color = grad(0.12)
                end
                w.Value.Size = ts
                w.Value.Position = P(rx + rw - 8 - tw(w.Value), ry + textY)
                w.Value.Visible = true
            elseif it.type == "button" then
                w.Label.Position = P(rx + 8, ry + textY)
                w.Label.Color = gradAnim(0.12, drift)
            elseif it.type == "sep" then
                w.Hover.Visible = false
                w.SepText.Text = "── " .. string.upper(it.label) .. " ──"
                w.SepText.Size = math.max(ts - 4, 10)
                w.SepText.Position = P(rx + rw / 2, ry + (ROWH - w.SepText.Size) / 2)
                w.SepText.Color = gradAnim(0.5, drift)
                w.SepText.Visible = true
            else -- slider
                w.Label.Position = P(rx + 8, ry + textY)
                local trackX, trackW = sliderGeom(rx, rw)
                w.Track.Position = Vector2.new(trackX, ry + 9)
                w.Track.Size = Vector2.new(trackW, 6)
                w.Track.Visible = true

                local ratio = math.clamp((val - it.min) / (it.max - it.min), 0, 1)
                local fillW = trackW * ratio
                local n = #w.Strips
                local segW = trackW / n
                for i, st in ipairs(w.Strips) do
                    local pw = math.clamp(fillW - (i - 1) * segW, 0, segW)
                    if pw > 0.5 then
                        st.Position = Vector2.new(trackX + (i - 1) * segW, ry + 9)
                        st.Size = Vector2.new(pw + (pw >= segW and 1 or 0), 6)
                        st.Color = grad(0.05 + 0.85 * (i - 0.5) / n)
                        st.Visible = true
                    else
                        st.Visible = false
                    end
                end

                w.Value.Text = it.step < 1 and string.format("%.2f", val) or tostring(math.floor(val + 0.5))
                w.Value.Size = ts
                w.Value.Position = P(rx + rw - 6 - tw(w.Value), ry + textY)
                w.Value.Visible = true
            end
        end
    end
end

----------------------------------------------------------------------
-- Aimbot
----------------------------------------------------------------------
local AimAll = {}
local function aimNew(class, props)
    local d = Drawing.new(class)
    for k, v in pairs(props) do d[k] = v end
    d.ZIndex = 50
    d.Visible = false
    AimAll[#AimAll + 1] = d
    return d
end

local fovCircle = aimNew("Circle", { Filled = false, Thickness = 1.5, NumSides = 64, Transparency = 1 })
local lockLine = aimNew("Line", { Thickness = 1.5, Transparency = 0.9 })
local lockDot = aimNew("Circle", { Filled = true, Radius = 3, NumSides = 12, Transparency = 1 })

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function aimKeyDown()
    local k = Settings.AimKey
    if k == "Always On" then return true end
    if k == "Left Mouse" then
        return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    end
    return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
end

local function getAimPart(char, root)
    local part
    if Settings.AimPart == "Head" then
        part = char:FindFirstChild("Head")
    else
        part = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    end
    return part or root
end

local function hasLineOfSight(part, char)
    local myChar = LocalPlayer.Character
    rayParams.FilterDescendantsInstances = { myChar, char, Camera }
    local origin = Camera.CFrame.Position
    return workspace:Raycast(origin, part.Position - origin, rayParams) == nil
end

local function consider(char, origin, best)
    if not char then return best end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return best end
    local root = hum.RootPart or char.PrimaryPart or char:FindFirstChild("HumanoidRootPart")
    if not root then return best end

    local part = getAimPart(char, root)
    if (Camera.CFrame.Position - part.Position).Magnitude > Settings.MaxDistance then return best end

    local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen then return best end

    local d = (Vector2.new(sp.X, sp.Y) - origin).Magnitude
    if d > Settings.AimFOV or (best and d >= best.dist) then return best end

    if Settings.AimWallCheck and not hasLineOfSight(part, char) then return best end

    return { dist = d, part = part, screen = Vector2.new(sp.X, sp.Y) }
end

local function aimStep(dt)
    if unloaded then return end
    Camera = workspace.CurrentCamera

    -- runs right after the game's camera script, so FOV easing wins over resets
    fovStep(dt)

    local mouse = UserInputService:GetMouseLocation()
    local origin = mouse
    if Settings.AimOrigin == "Screen" then
        origin = Camera.ViewportSize / 2
    end

    local active = Settings.AimEnabled

    fovCircle.Visible = active and Settings.AimShowFOV
    if fovCircle.Visible then
        fovCircle.Position = origin
        fovCircle.Radius = Settings.AimFOV
        fovCircle.Color = gradAnim(0.3, os.clock() * 0.1)
    end

    lockLine.Visible = false
    lockDot.Visible = false

    if not active or not aimKeyDown() then return end
    if UI.Open and inRect(mouse, UI.X, UI.Y, UI.W, UI.H) then return end

    local best
    local myChar = LocalPlayer.Character

    if Settings.Targets ~= "NPCs Only" then
        for player in pairs(Tracked) do
            local blocked = Settings.TeamCheck and player.Team ~= nil and player.Team == LocalPlayer.Team
            if not blocked then
                best = consider(player.Character, origin, best)
            end
        end
    end
    if Settings.Targets ~= "Players Only" then
        for model in pairs(NPCModels) do
            if model.Parent and model ~= myChar and not Players:GetPlayerFromCharacter(model) then
                best = consider(model, origin, best)
            end
        end
    end

    if not best then return end

    local alpha = 1 / math.max(Settings.AimSmooth, 1)

    if Settings.AimMethod == "Mouse" and mousemoverel then
        mousemoverel((best.screen.X - mouse.X) * alpha, (best.screen.Y - mouse.Y) * alpha)
    else
        local camPos = Camera.CFrame.Position
        local goal = CFrame.lookAt(camPos, best.part.Position)
        Camera.CFrame = Camera.CFrame:Lerp(goal, alpha)
    end

    lockLine.From = origin
    lockLine.To = best.screen
    lockLine.Color = grad(0.48)
    lockLine.Visible = true
    lockDot.Position = best.screen
    lockDot.Color = grad(0.05)
    lockDot.Visible = true
end

RunService:BindToRenderStep("SundownAim", Enum.RenderPriority.Camera.Value + 1, aimStep)

