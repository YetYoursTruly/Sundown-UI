-- Input
----------------------------------------------------------------------
unload = function()
    if unloaded then return end

    saveSettings() -- save first, so fullbright / FOV / etc. come back next time

    -- undo everything that touched the game
    Settings.Fullbright = false
    fullbrightStep()

    Settings.FOVEnabled = false
    if fovState.active then
        workspace.CurrentCamera.FieldOfView = fovState.orig
        fovState.active = false
    end
    if lastFOV and lastFOV ~= 70 then
        sendFOV(70, true)
    end

    Settings.Fly = false
    local _, hum, root = getChar()
    if hum then hum.PlatformStand = false end
    if root then root.AssemblyLinearVelocity = Vector3.zero end
    restoreNoclip()

    unloaded = true
    pcall(function() RunService:UnbindFromRenderStep("SundownAim") end)
    for _, c in ipairs(Conns) do
        c:Disconnect()
    end
    for key in pairs(Sets) do
        release(key)
    end
    for _, d in ipairs(UIAll) do
        d:Remove()
    end
    for _, d in ipairs(AimAll) do
        d:Remove()
    end
    getgenv().UnloadESP = nil
    getgenv().ESPSettings = nil
end

Conns[#Conns + 1] = UserInputService.InputBegan:Connect(function(input, gp)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        -- rebinding: the next key pressed becomes the new bind
        if UI.Listening then
            local it = UI.Listening.item
            local kc = input.KeyCode
            if kc == Enum.KeyCode.Escape then
                -- cancel, keep the old key
            elseif kc == Enum.KeyCode.Backspace or kc == Enum.KeyCode.Delete then
                Settings[it.key] = it.required and Defaults[it.key] or "None"
                markDirty()
            elseif kc ~= Enum.KeyCode.Unknown then
                Settings[it.key] = kc.Name
                markDirty()
            end
            UI.Listening = nil
            return
        end

        if gp then return end

        if pressed(input, "BindMenu") then
            UI.Open = not UI.Open
        elseif pressed(input, "BindUnload") then
            unload()
        elseif pressed(input, "BindFly") then
            Settings.Fly = not Settings.Fly
        elseif pressed(input, "BindFullbright") then
            Settings.Fullbright = not Settings.Fullbright
            markDirty()
        end
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    local m = UserInputService:GetMouseLocation()

    -- hold the Click TP key + click to teleport (not when clicking on the menu)
    if Settings.ClickTP and keyDown("BindClickTP")
        and not (UI.Open and inRect(m, UI.X, UI.Y, UI.W, UI.H)) then
        clickTeleport()
        return
    end

    if not UI.Open then return end

    UI.Listening = nil

    if inRect(m, UI.X + UI.W - GRIP, UI.Y + UI.H - GRIP, GRIP, GRIP) then
        UI.Resize = { MX = m.X, MY = m.Y, W = UI.W, H = UI.H }
        return
    end

    if inRect(m, UI.X, UI.Y, UI.W, HEADER) then
        UI.Drag = Vector2.new(m.X - UI.X, m.Y - UI.Y)
        return
    end

    local tabW = (UI.W - 12) / #TABS
    for i = 1, #TABS do
        if inRect(m, UI.X + 6 + (i - 1) * tabW, UI.Y + HEADER + 8, tabW - 4, TABH) then
            UI.Tab = i
            markDirty()
            return
        end
    end

    for _, w in ipairs(Widgets) do
        if w.tab == UI.Tab and rowVisible(w) then
            local rx, ry, rw = rowRect(w)
            if inRect(m, rx, ry, rw, ROWH) then
                local it = w.item
                if it.type == "sep" then
                    return
                elseif it.type == "toggle" then
                    Settings[it.key] = not Settings[it.key]
                    markDirty()
                elseif it.type == "cycle" then
                    local opts = it.getOptions and it.getOptions() or it.options
                    local idx = table.find(opts, Settings[it.key]) or 0
                    Settings[it.key] = opts[idx % #opts + 1]
                    markDirty()
                elseif it.type == "bind" then
                    UI.Listening = w
                elseif it.type == "button" then
                    it.action()
                else
                    UI.Slider = w
                    applySlider(w, m.X)
                end
                return
            end
        end
    end
end)

Conns[#Conns + 1] = UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if UI.Drag or UI.Resize or UI.Slider then
            markDirty()
        end
        UI.Drag, UI.Resize, UI.Slider = nil, nil, nil
    end
end)

Conns[#Conns + 1] = UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        local m = UserInputService:GetMouseLocation()
        if UI.Open and inRect(m, UI.X, UI.Y, UI.W, UI.H) then
            UI.ScrollT[UI.Tab] = math.clamp(UI.ScrollT[UI.Tab] - input.Position.Z, 0, maxScroll(UI.Tab))
        else
            -- player zoomed the camera: re-capture the new distance for the next hover
            UI.HaveZoom = false
            UI.ZoomLock = false
        end
    end
end)

----------------------------------------------------------------------
-- Main loop
----------------------------------------------------------------------
local npcActive = false

local function computeOrigin()
    local vp = Camera.ViewportSize
    local o = Settings.TracerOrigin
    if o == "Center" then
        return Vector2.new(vp.X / 2, vp.Y / 2)
    elseif o == "Mouse" then
        return UserInputService:GetMouseLocation()
    end
    return Vector2.new(vp.X / 2, vp.Y)
end

Conns[#Conns + 1] = RunService.RenderStepped:Connect(function(dt)
    Camera = workspace.CurrentCamera
    renderUI(dt)
    fullbrightStep()

    -- debounced auto-save (1s after the last change, never while dragging)
    if dirtyAt and not (UI.Drag or UI.Resize or UI.Slider) and os.clock() - dirtyAt > 1 then
        dirtyAt = nil
        saveSettings()
    end

    if not Settings.Enabled then
        for _, s in pairs(Sets) do
            hideSet(s)
        end
        return
    end

    if Settings.Tracers then
        TracerOrigin = computeOrigin()
    end

    local showPlayers = Settings.Targets ~= "NPCs Only"
    local showNPCs = Settings.Targets ~= "Players Only"

    if showPlayers then
        for player in pairs(Tracked) do
            local char = player.Character
            local hum, root, dist, pos = locate(char)
            local s = Sets[player]
            local blocked = Settings.TeamCheck and player.Team ~= nil and player.Team == LocalPlayer.Team
            if hum and not blocked then
                s = s or acquire(player)
                draw(s, char, hum, root, dist, pos, player.DisplayName)
            elseif s then
                hideSet(s)
            end
        end
    else
        for player in pairs(Tracked) do
            local s = Sets[player]
            if s then hideSet(s) end
        end
    end

    if showNPCs then
        npcActive = true
        local myChar = LocalPlayer.Character
        for model in pairs(NPCModels) do
            if not model.Parent then
                NPCModels[model] = nil
                release(model)
            elseif model ~= myChar and not Players:GetPlayerFromCharacter(model) then
                local hum, root, dist, pos = locate(model)
                local s = Sets[model]
                if hum then
                    s = s or acquire(model)
                    draw(s, model, hum, root, dist, pos, model.Name)
                elseif s then
                    hideSet(s)
                end
            end
        end
    elseif npcActive then
        npcActive = false
        for model in pairs(NPCModels) do
            release(model)
        end
    end
end)

getgenv().ESPSettings = Settings
getgenv().UnloadESP = unload

-- create the SUNDOWN folder + first settings file right away
saveSettings()

return Settings
